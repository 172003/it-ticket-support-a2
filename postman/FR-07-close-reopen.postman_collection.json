{
  "info": {
    "name": "FR-07 close-reopen",
    "description": "FR-07 (IT-67): close and reopen a ticket. Run the requests in order, top to bottom. Set these Postman environment variables first: endUserEmail, endUserPassword, agentEmail, agentPassword. The collection fills endUserToken, agentToken and ticketId itself. The Agent account needs role Agent in the database. API-10b needs a manual step: edit resolvedAt in Atlas to 8 days ago. No tokens or passwords are stored in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login End User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{endUserEmail}}\",\n  \"password\": \"{{endUserPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.environment.set(\"endUserToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login Agent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{agentEmail}}\",\n  \"password\": \"{{agentPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.environment.set(\"agentToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create ticket (End User)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{endUserToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"FR-07 close test\",\n  \"description\": \"Ticket used to test close and reopen\",\n  \"priority\": \"Medium\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Ticket is Open\", () => pm.expect(pm.response.json().status).to.eql(\"Open\"));",
              "pm.environment.set(\"ticketId\", pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "API-09 Close Open ticket -> 400",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/close",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets",
            "{{ticketId}}",
            "close"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{endUserToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Message says Open\", () => pm.expect(pm.response.json().message).to.include(\"Open\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Agent resolves ticket",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets",
            "{{ticketId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{agentToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Resolved\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Ticket is Resolved\", () => pm.expect(pm.response.json().status).to.eql(\"Resolved\"));",
              "pm.test(\"resolvedAt is saved\", () => pm.expect(pm.response.json().resolvedAt).to.exist);"
            ]
          }
        }
      ]
    },
    {
      "name": "API-11 Close as non-owner -> 403",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/close",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets",
            "{{ticketId}}",
            "close"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{agentToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-08 Close Resolved ticket -> 200",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/close",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets",
            "{{ticketId}}",
            "close"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{endUserToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Ticket is Closed\", () => pm.expect(pm.response.json().status).to.eql(\"Closed\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-10 Reopen within 7 days -> 200",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/reopen",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets",
            "{{ticketId}}",
            "reopen"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{endUserToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Ticket is Open\", () => pm.expect(pm.response.json().status).to.eql(\"Open\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-11b Reopen as non-owner -> 403",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/reopen",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets",
            "{{ticketId}}",
            "reopen"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{agentToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Agent resolves ticket again (before backdating)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets",
            "{{ticketId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{agentToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Resolved\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Run this, then in Atlas edit this ticket's resolvedAt to a date 8 days ago (keep the ISODate(...) wrapper), then run API-10b."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Ticket is Resolved\", () => pm.expect(pm.response.json().status).to.eql(\"Resolved\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-10b Reopen after 7 days -> 400",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/reopen",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets",
            "{{ticketId}}",
            "reopen"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{endUserToken}}",
              "type": "string"
            }
          ]
        },
        "description": "Only run after backdating resolvedAt in Atlas to 8 days ago."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Message mentions the 7-day window\", () => pm.expect(pm.response.json().message).to.include(\"7-day\"));"
            ]
          }
        }
      ]
    }
  ]
}